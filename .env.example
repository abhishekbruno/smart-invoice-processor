# Smart Invoice Processor Configuration

# Application Environment
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Storage Paths
INVOICE_WATCH_DIR=data/invoices
PROCESSED_DIR=data/processed
DB_PATH=data/invoices.db
CHROMA_DIR=storage/chroma

# Extraction & OCR
MAX_FILE_SIZE_MB=20
OCR_ENABLED=false
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# AI & Embeddings (Phase 2 - Google Gemini API)
EMBEDDING_MODEL=all-MiniLM-L6-v2
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Gmail Automation (Phase 3)
GMAIL_CREDENTIALS_FILE=config/credentials.json
GMAIL_TOKEN_FILE=config/token.json
GMAIL_SYNC_INTERVAL_MINUTES=15
GMAIL_SEARCH_QUERY=has:attachment filename:pdf

